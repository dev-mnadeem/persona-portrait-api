# Copy to .env and edit. Real environment variables override this file.
# Every value below has a working default: the app boots with no .env at all.

# --- Django -----------------------------------------------------------------
# Required once DJANGO_DEBUG is off; the app refuses to start without it.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
# Absolute path for the SQLite file (default: <repo>/db.sqlite3)
DJANGO_DB_PATH=
# Where generated portraits are written (default: <repo>/media)
DJANGO_MEDIA_ROOT=

# --- Image generation -------------------------------------------------------
# "local"  - deterministic offline renderer, no credentials, no network
# "openai" - calls the OpenAI images endpoint
# Leave blank to pick automatically: openai if OPENAI_API_KEY is set, else local.
IMAGE_PROVIDER=
IMAGE_SIZE=1024x1024

OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_TIMEOUT_SECONDS=60

# --- API --------------------------------------------------------------------
CHARACTER_PAGE_SIZE=20
# DRF throttle rate for POST /api/characters/ (the endpoint that costs money)
IMAGE_GENERATION_RATE=30/hour
